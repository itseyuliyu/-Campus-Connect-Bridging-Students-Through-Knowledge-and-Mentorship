// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model College {
  abbreviation String @id
  name String
  departments Department[]
  students Student[]
}

model Department {
  id Int @id @default(autoincrement())
  name String
  abbreviation String @unique
  college College @relation(fields: [collegeName], references: [abbreviation])
  collegeName String
  students Student[]
  projects Project[]
}

model Student {
  id Int @id @default(autoincrement())
  username String @unique
  password String
  email String @unique
  fname String
  lname String
  classYear Int
  bio String?
  department Department @relation(fields: [departmentId], references: [id])
  departmentId Int
  college College @relation(fields: [collegeName], references: [abbreviation])
  collegeName String
  projects Project[]
}

// model Course {
//   id Int @id @default(autoincrement())
//   name String
// }

model Project {
  id Int @id @default(autoincrement())
  course String
  title String
  classYear Int
  student Student @relation(fields: [studentId], references: [id])
  studentId Int
  department Department @relation(fields: [departmentId], references: [id])
  departmentId Int
  createdAt DateTime?
  uploadDate DateTime @default(now())
}